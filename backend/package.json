{
  "name": "@alfacode/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API for AlfaCode HUB.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "migration:revert": "tsx src/database/run-migrations.ts revert",
    "migration:run": "tsx src/database/run-migrations.ts run",
    "migration:show": "tsx src/database/run-migrations.ts show",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/typeorm": "^12.0.2",
    "better-sqlite3": "^12.11.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
