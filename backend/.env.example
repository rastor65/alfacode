NODE_ENV=development
BACKEND_PORT=4000
CORS_ORIGINS=http://localhost:3000
DB_TYPE=sqlite
SQLITE_PATH=./data/alfacode-hub.sqlite
# DATABASE_URL=postgresql://usuario:clave@localhost:5432/alfacode_hub # futuro, cuando se retome DB_TYPE=postgres
# Sesion y seguridad (I-05). En NODE_ENV distinto de development las cookies llevan Secure.
SESSION_COOKIE_NAME=alfacode_session
CSRF_COOKIE_NAME=alfacode_csrf
# Limpieza de sesiones vencidas en ms; 0 la desactiva.
SESSION_CLEANUP_INTERVAL_MS=3600000
# Proxies de confianza para X-Forwarded-For (DEC-006). En desarrollo, el servidor de Next.js local.
# En produccion es obligatorio: direccion/subred del servidor de Next.js, numero de saltos, o false.
TRUST_PROXY=loopback
# Correo y enlaces (I-06). URL publica del frontend usada en los enlaces enviados por correo.
APP_PUBLIC_URL=http://localhost:3000
# outbox (desarrollo: un .eml por correo en MAIL_OUTBOX_DIR) | smtp (envio real) | memory (pruebas) | none.
# En produccion solo se admiten smtp o none; con none el registro publico y la recuperacion quedan
# deshabilitados y las invitaciones devuelven el enlace una sola vez a quien invita.
MAIL_TRANSPORT=outbox
MAIL_OUTBOX_DIR=./data/outbox
# Envio real con Google (DEC-015). Requiere verificacion en dos pasos y una contrasena de aplicacion
# creada en https://myaccount.google.com/apppasswords (en cuentas de la universidad, el administrador
# de Google Workspace puede tenerla bloqueada). Nunca la subas a Git. Prueba: npm run backend:mail:test -- tu@uniguajira.edu.co
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=cuenta@uniguajira.edu.co
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# MAIL_FROM=AlfaCode HUB <cuenta@uniguajira.edu.co>
# Dominios de correo autorizados (DEC-010). Por defecto solo el institucional; comparacion exacta,
# sin subdominios. Aplica a registro, invitaciones, aceptacion, bootstrap del admin y login.
ALLOWED_EMAIL_DOMAINS=uniguajira.edu.co
