NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=/api/v1
API_PROXY_TARGET=http://localhost:4000
# Proxies inversos de confianza delante de Next.js (0 = recibe conexiones directas).
# El servidor personalizado (server/index.mjs) deriva la IP real del cliente y la envia
# al backend como unica entrada de X-Forwarded-For (DEC-006).
FRONTEND_TRUSTED_PROXY_HOPS=0
